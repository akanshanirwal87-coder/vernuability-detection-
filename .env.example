# ==============================================================================
# SecureCode AI - Environment Configuration Example
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=false
HOST=0.0.0.0
PORT=8000

# CORS Configuration
# Comma-separated list of trusted origins (strictly enforce without wildcards when credentials are used)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# JWT Authentication
# In production, generate a strong random secret key (e.g. `openssl rand -hex 32`)
JWT_SECRET_KEY=change-in-production-securecode-ai-secret-key-32bytes-hex
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Administrative Credentials & Retraining Protection
ADMIN_USERNAME=admin
# Pre-computed PBKDF2 hash of default password 'AdminSecure2026!'
# Format: pbkdf2:sha256:100000$<salt_hex>$<hash_hex>
ADMIN_PASSWORD_HASH=pbkdf2:sha256:100000$63c78684c130bf94b3a4dde70fd55543$30b6cd2bb120cef576d969a1a9fc22ff3ba2476334ad520321342156febf58cf
ADMIN_API_KEY=sec-admin-phase1-production-token-9f82d1c

# File Upload Security Restrictions
# Maximum upload file size in bytes (default 5MB = 5242880 bytes)
MAX_UPLOAD_SIZE_BYTES=5242880

# Rate Limiting
# Maximum permitted requests per client IP per minute
RATE_LIMIT_PER_MINUTE=60

# Database Storage & PostgreSQL Configuration
# Production PostgreSQL connection URL (SQLAlchemy 2.x with psycopg3)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/securecode_ai
# SQLite fallback / development local database:
# DATABASE_URL=sqlite:///./backend/scans.db
TEST_DATABASE_URL=sqlite:///:memory:
DB_PATH=/workspaces/vernuability-detection-/backend/scans.db

# Authentication Token Lifespans
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
